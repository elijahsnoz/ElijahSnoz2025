# URL of the FastAPI + Demucs backend (see ../ai-music-backend). Server-side only, never exposed to the browser.
BACKEND_URL=http://127.0.0.1:8000

# Same backend, but public: the browser uploads the raw song file here directly
# (see lib/upload.ts) since Vercel caps a serverless function's request body at
# ~4.5MB, far below real songs. Must match BACKEND_URL's public domain in prod,
# and the backend's ALLOWED_ORIGINS must include this site's origin.
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# URL of the vocal FX service (see ../ai-vocal-fx-backend). Server-side only.
VOCAL_FX_BACKEND_URL=http://127.0.0.1:8001

# URL of the mastering service (see ../ai-mastering-backend). Server-side only.
MASTERING_BACKEND_URL=http://127.0.0.1:8002
