{
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/ai", "destination": "https://ai-music-lab-sooty.vercel.app/ai" },
    { "source": "/ai/:path*", "destination": "https://ai-music-lab-sooty.vercel.app/ai/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(jpg|jpeg|png|gif|svg|webp|ico|mp4|mp3|pdf|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
