# Set this in the ajayi-ar Vercel project's Environment Variables to that
# project's own deployment URL (e.g. https://ajayi-ar.vercel.app or a
# custom domain you've pinned in Vercel's project settings). This makes
# Next.js load this app's /_next/* JS/CSS directly from its own origin
# instead of needing a root-domain /_next/* rewrite — which is already
# claimed by ai-music-lab (see ../vercel.json). Leave unset for local dev.
AJAYI_AR_ASSET_PREFIX=https://ajayi-ar.vercel.app
